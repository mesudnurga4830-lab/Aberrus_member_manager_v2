# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Telegram bot API token from @BotFather (e.g. 123456789:ABCDefgh...).
# Server-side environment variable only — never exposed to client-side frontend code.
TELEGRAM_BOT_TOKEN=""

# VITE_ADMIN_TELEGRAM_CHAT_ID: Private Telegram chat ID for Admin ONLY (receives member complaints privately; never group).
VITE_ADMIN_TELEGRAM_CHAT_ID=""

# ADMIN_TELEGRAM_CHAT_ID: Optional server-side fallback for private Admin Telegram chat ID.
ADMIN_TELEGRAM_CHAT_ID=""

# VITE_TELEGRAM_GROUP_CHAT_ID: Telegram Group chat ID ONLY for approved single & bulk payment reports.
VITE_TELEGRAM_GROUP_CHAT_ID=""

# EXECUTIVE_CHAT_ID: Optional Telegram chat ID for the Executive Officer to receive aggregated reports
EXECUTIVE_CHAT_ID=""

# FINANCE_CHAT_ID: Optional Telegram chat ID for the Finance Officer to receive aggregated reports
FINANCE_CHAT_ID=""

# SECRETARY_CHAT_ID: Optional Telegram chat ID for the Secretary to receive operational reports
SECRETARY_CHAT_ID=""

# FIREBASE_SERVICE_ACCOUNT_KEY: Full JSON string of Firebase Service Account for Vercel serverless functions (api/webhook.ts)
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Alternative individual Firebase Admin SDK credentials (used if FIREBASE_SERVICE_ACCOUNT_KEY is not set)
FIREBASE_PROJECT_ID="ageless-arcana-10z9n"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_ID="ai-studio-abarrusmemberman-f04164f2-0f63-40d2-937b-02ccc27b30e9"
